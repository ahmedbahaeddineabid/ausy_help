# Add to auzy-backend's environment (AI v2 for test accounts). Everyone not listed keeps today's chat.
AI_V2_ENABLED=true
# Profile ids (comma-separated) that use AI v2; "*" = everyone. Start with your own test accounts.
AI_V2_TEST_PROFILES=
# The API, on the internal network.
AI_V2_URL=http://AUZY_AI_API_HOST:8080
# = the API's AUZY_AI_API_KEY
AI_V2_API_KEY=
# = the API's AUZY_CALLBACK_SECRET (checked on /internal/ai/*)
AI_V2_CALLBACK_SECRET=
# After this, the message is answered by today's chat instead.
AI_V2_TIMEOUT_MS=120000
