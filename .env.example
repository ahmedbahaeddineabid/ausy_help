# Auzy AI API settings. Copy to .env, fill in, and never commit .env.
# Generate each secret separately (64 hex characters):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ---- Claude
# A NEW key for this service. The key used during development was shared in a chat and must be revoked.
ANTHROPIC_API_KEY=

# ---- Access to the API
# auzy-backend -> API (Authorization: Bearer <key>): messages and end of conversation.
AUZY_AI_API_KEY=
# Staff views: summaries, costs, conversation state, clear escalation. A different value; empty = disabled.
AUZY_AI_STAFF_TOKEN=

# ---- Storage: a separate database on Auzy's MongoDB (never Auzy's own database)
STORE=mongo
MONGODB_URI=mongodb://USER:PASSWORD@MONGO_HOST:27017/?authSource=admin
MONGODB_DB=auzy_ai

# ---- auzy-backend callbacks (integration/): the three lookups, the Cognisys snapshot, the analysis delivery
AUZY_MODE=callback
AUZY_CALLBACK_URL=http://AUZY_BACKEND_HOST:PORT/internal/ai
# Shared with auzy-backend (its AI_V2_CALLBACK_SECRET). A third, different value.
AUZY_CALLBACK_SECRET=

# ---- Care team (internal channels only: these messages carry health information)
ESCALATION_WEBHOOK_URL=
SUMMARY_WEBHOOK_URL=
# Confirm with your clinicians before going live.
EMERGENCY_NUMBER=190
SUMMARY_LANGUAGE=French

# ---- Budget (defaults)
AI_TARGET_MIN_PER_1000_USD=50
AI_TARGET_MAX_PER_1000_USD=80
AI_CONVERSATION_CEILING_USD=0.15
AI_QUALITY_LANGUAGES=ar,aeb
AI_START_LEVEL=1
AI_IDLE_MINUTES=30

# ---- Docker compose
# Address and port where the API is published; auzy-backend must reach it (a private address, never public).
AI_API_BIND=127.0.0.1
AI_API_PORT=8080
# Small server (under 2 GB of RAM): RISK_MODEL=tfidf (10 MB model, weaker on indirect wording and Arabic/Derja).
RISK_MODEL=xlmr

# ---- Running without Docker (cd auzy-ai-v2 && node --env-file=../.env server/index.js)
# RISK_SERVICE_URL=http://127.0.0.1:8001
# PORT=8080
